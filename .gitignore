.env
venv/
__pycache__/
*.pyc
*.csv
*.geojson
data/
# Exception: backend/data/osm.db is a deliberate vendored copy the
# Backend service needs at runtime on Railway (rootDirectory is
# /backend, so the repo-root data/ directory -- the pipeline's real
# working copy, regenerated by analysis/ scripts -- never reaches that
# deploy). This is the only file meant to be committed from any `data/`
# directory anywhere in the repo.
!backend/data/
!backend/data/osm.db
out/
geometry/snapped.json
.ipynb_checkpoints/
*.ipynb
.vscode/
.idea/
.DS_Store
*.log
node_modules/
dist/

# Reversible backups written by cleanup_degenerate_bridges.py
degenerate_bridges_backup_*.json
route_data_backup_*.json
.claude